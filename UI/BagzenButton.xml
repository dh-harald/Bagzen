<?xml version="1.0"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/FrameXML\UI.xsd">

  <Script file="BagzenButton.lua"/>

  <Font name="BagzenFont" font="Interface\AddOns\Bagzen\fonts\PTSansNarrow.ttf" virtual="true" inherits="GameFontNormal">
    <Shadow>
      <Offset>
        <AbsDimension x="1" y="-1"/>
      </Offset>
      <Color r="0" g="0" b="0"/>
     </Shadow>
     <FontHeight>
      <AbsValue val="12"/>
     </FontHeight>
     <Color r="1.0" g="0.82" b="0"/>
  </Font>

  <Font name="BagzenFontOutline" font="Interface\AddOns\Bagzen\fonts\PTSansNarrow.ttf" outline="NORMAL" virtual="true" inherits="GameFontHighlight">
    <Shadow>
      <Offset>
        <AbsDimension x="1" y="-1"/>
      </Offset>
      <Color r="0" g="0" b="0"/>
     </Shadow>
     <FontHeight>
      <AbsValue val="12"/>
     </FontHeight>
     <Color r="1.0" g="0.82" b="0"/>
  </Font>

  <Button name="BagzenOnlineButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\online"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\online"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\online"/>
    <Scripts>
      <OnEnter>
        Bagzen:ButtonTooltip("Online")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenOfflineButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\offline"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\offline"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\offline"/>
    <Scripts>
      <OnEnter>
        Bagzen:ButtonTooltip("Offline")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenBankButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\bank"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\bank"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\bankh"/>
    <Scripts>
      <OnClick>
        Bagzen:BankFrameToggle()
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Bank")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenCharactersButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\characters"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\characters"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\charactersh"/>
    <Scripts>
      <OnClick>
        Bagzen:CharactersFrameToggle(this)
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Characters")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenBagButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\bags"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\bags"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\bagsh"/>
    <Scripts>
      <OnClick>
        Bagzen:BagSlotsToggle(this:GetParent())
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Bag slots")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenSortButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\sort"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\sort"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\sorth"/>
    <Scripts>
      <OnClick>
        Bagzen:SortButtonOnClick(this)
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Sort")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenSettingsButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\settings"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\settings"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\settingsh"/>
    <Scripts>
      <OnClick>
        Bagzen:OpenOptions()
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Settings")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenCloseButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="16"/>
    </Size>
    <NormalTexture file="Interface\AddOns\Bagzen\icons\close"/>
    <PushedTexture file="Interface\AddOns\Bagzen\icons\close"/>
    <HighlightTexture file="Interface\AddOns\Bagzen\icons\closeh"/>
    <Scripts>
      <OnClick>
        Bagzen:CloseButtonOnClick(this)
      </OnClick>
      <OnEnter>
        Bagzen:ButtonTooltip("Close")
      </OnEnter>
      <OnLeave>
        GameTooltip:Hide()
      </OnLeave>
    </Scripts>
  </Button>

  <Button name="BagzenKeychainButton" virtual="true">
    <Size>
      <AbsDimension x="16" y="8"/>
    </Size>
    <Scripts>
      <OnLoad>
        this:SetNormalTexture("Interface\\AddOns\\Bagzen\\icons\\key")
        this:SetHighlightTexture("Interface\\AddOns\\Bagzen\\icons\\key")
        this:SetPushedTexture("Interface\\AddOns\\Bagzen\\icons\\key")
      </OnLoad>
      <OnClick>
        Bagzen:KeyChainButtonOnClick(this)
      </OnClick>
      <OnEnter>
        if this:GetParent().KeyChain then
          Bagzen:HighlightSlots(this:GetParent(), KEYRING_CONTAINER)
        end
      </OnEnter>
      <OnLeave>
        if this:GetParent().KeyChain then
          Bagzen:UnHighlightSlots(this:GetParent())
        end
      </OnLeave>
    </Scripts>
  </Button>
</Ui>
